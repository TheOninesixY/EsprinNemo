#!/bin/sh

if ! command -v bun >/dev/null 2>&1; then
  for candidate in "$BUN_INSTALL/bin/bun" "$BUN_INSTALL/bin/bun.exe" "$HOME/.bun/bin/bun" "$HOME/.bun/bin/bun.exe"; do
    if [ -x "$candidate" ]; then
      PATH="$(dirname "$candidate"):$PATH"
      export PATH
      break
    fi
  done
fi

if command -v bun >/dev/null 2>&1; then
  bun scripts/clean.js src/ || exit $?
  git add .
else
  echo "[husky] [WARN] 未找到 bun，已跳过 clean.js" >&2
fi
