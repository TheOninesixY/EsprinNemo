{
  "name": "esprin_nemo",
  "version": "3.3.2",
  "main": "src/main/main.js",
  "description": "Note, Nothing.",
  "icon": "src/assets/icon.png",
  "svg_icon": "src/assets/icon.svg",
  "author": "TheOninesixY <oninesixy@qq.com>",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --linux --publish never",
    "build:all": "bun run build&&bun build:web&&bun build:sync",
    "start:web": "bun scripts/web_server.js",
    "build:web": "bun scripts/web_build.js",
    "start:sync": "bun src/sync/server.js",
    "build:sync": "bun scripts/sync_build.js"
  },
  "private": true,
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "io.github.theoninesixy.esprin_nemo",
    "productName": "Esprin Nemo",
    "icon": "src/assets/icon.png",
    "files": [
      "src/",
      "!src/sync/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "EsprinNemo.Portable.v${version}.${ext}"
    },
    "nsis": {
      "artifactName": "EsprinNemo.Setup.v${version}.${ext}",
      "include": "src/win_installer/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "Esprin Nemo"
    },
    "linux":{
      "target":[
        "appimage"
      ],
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "category": "Utility",
      "synopsis": "Note, Nothing.",
      "maintainer": "TheOninesixY <oninesixy@qq.com>"
    },
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "material-symbols": "^0.47.4"
  }
} 