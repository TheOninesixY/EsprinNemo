{
  "name": "esprin_nemo",
  "version": "3.4.1",
  "main": "src/desktop/main/main.js",
  "description": "Note, Nothing.",
  "icon": "assets/icon.png",
  "svg_icon": "assets/icon.svg",
  "author": "TheOninesixY <oninesixy@qq.com>",
  "scripts": {
    "start": "bun x electron .",
    "build": "electron-builder --win --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --universal --publish never",
    "build:all": "bun run build&&bun build:sync",
    "start:sync": "bun src/sync/server.js",
    "start:mobile": "bun scripts/mobile_serve.js",
    "start:website": "bun scripts/website_serve.js",
    "build:sync": "bun scripts/sync_build.js",
    "build:mobile": "bun scripts/mobile_build.js",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^24.6.0",
    "husky": "^9.1.7"
  },
  "build": {
    "appId": "io.github.theoninesixy.esprin_nemo",
    "productName": "EsprinNemo",
    "afterPack": "scripts/mac_after_pack.js",
    "files": [
      "src/desktop/",
      "assets/",
      "!src/sync/**",
      "!src/mobile/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "EsprinNemo.Portable.v${version}.${ext}"
    },
    "nsis": {
      "artifactName": "EsprinNemo.Setup.v${version}.${ext}",
      "include": "src/desktop/win_installer/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "EsprinNemo"
    },
    "linux": {
      "target": [
        "appimage"
      ],
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "category": "Utility",
      "synopsis": "Note, Nothing.",
      "maintainer": "TheOninesixY <oninesixy@qq.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "NSHumanReadableCopyright": "Copyright © 2026 TheOninesixY"
      }
    },
    "dmg": {
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "title": "EsprinNemo",
      "backgroundColor": "#0d1117",
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "material-symbols": "^0.47.4",
    "ui-ux-pro-max-cli": "^2.15.0"
  }
}
