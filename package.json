{
  "name": "esprin_nemo",
  "version": "3.4.1",
  "main": "src/desktop/main/main.js",
  "description": "Note, Nothing.",
  "icon": "assets/icon.png",
  "svg_icon": "assets/icon.svg",
  "author": "TheOninesixY <oninesixy@qq.com>",
  "scripts": {
    "start": "bun x electron .",
    "build": "electron-builder --win --linux --publish never && bun build/move_intermediates.js",
    "build:win": "electron-builder --win --publish never && bun build/move_intermediates.js",
    "build:linux": "electron-builder --linux --publish never && bun build/move_intermediates.js",
    "build:mac": "bun build/macos/patch_dmgbuild.js && electron-builder --mac --universal --publish never && bun build/move_intermediates.js",
    "build:all": "bun run build&&bun build:sync",
    "start:sync": "bun src/sync/server.js",
    "start:mobile": "bun build/mobile/serve.js",
    "build:sync": "bun build/sync/build.js",
    "build:mobile": "bun build/mobile/build.js",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^24.6.0",
    "husky": "^9.1.7"
  },
  "build": {
    "appId": "io.github.theoninesixy.esprin_nemo",
    "productName": "EsprinNemo",
    "afterPack": "build/macos/after_pack.js",
    "files": [
      "src/desktop/",
      "assets/",
      "!src/sync/**",
      "!src/mobile/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/windows/icon.ico"
    },
    "portable": {
      "artifactName": "EsprinNemo.Portable.v${version}.${ext}"
    },
    "nsis": {
      "artifactName": "EsprinNemo.Setup.v${version}.${ext}",
      "include": "build/windows/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "EsprinNemo"
    },
    "linux": {
      "target": [
        "appimage"
      ],
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "category": "Utility",
      "synopsis": "Note, Nothing.",
      "maintainer": "TheOninesixY <oninesixy@qq.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.mac.icns",
      "category": "public.app-category.productivity",
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "NSHumanReadableCopyright": "Copyright © 2026 TheOninesixY"
      }
    },
    "dmg": {
      "artifactName": "EsprinNemo.v${version}.${ext}",
      "title": "EsprinNemo",
      "background": "build/macos/dmg_background.tiff",
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 96,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 160,
          "y": 205
        },
        {
          "x": 500,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "material-symbols": "^0.47.4",
    "ui-ux-pro-max-cli": "^2.15.0"
  }
}
